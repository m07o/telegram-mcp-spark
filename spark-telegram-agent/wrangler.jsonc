{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark-telegram-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "MCP_SERVERS_KV",
      "id": "spark_mcp_servers"
    }
  ]
}
